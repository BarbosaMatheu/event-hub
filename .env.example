# Copy to ".env" (git-ignored) and adjust. docker compose reads it automatically.

POSTGRES_PASSWORD=change-me

# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Bootstrap administrator (created at startup if it does not exist yet).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-too

# true = load a demo catalogue when the database is empty; false for a clean installation.
APP_SEED_ENABLED=false

# Timezone that defines "now" for event times (venue-local wall-clock time).
APP_TIMEZONE=Europe/Madrid
